# Veřejná URL (canonical / OG). Lokálně typicky http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://zemtar.cz

# EmailJS – poptávkový formulář (text šablony: content/emailjs-template.txt)
# Account → API Keys + Security → „Allow EmailJS API for non-browser applications“
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Volitelně Resend (přílohy fotek) – použije se jen když EmailJS není nastavený
# RESEND_API_KEY=
# INQUIRY_TO=zemtarcz@gmail.com
# INQUIRY_FROM=poptavka@zemtar.cz
